<div id="<%= dom_id post %>">
  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Platform:</strong>
    <%= post.platform %>
  </div>

  <div>
    <strong>Scheduled at:</strong>
    <%= post.scheduled_at %>
  </div>

  <div>
    <strong>Caption:</strong>
    <%= post.caption %>
  </div>

  <div>
    <strong>Reference url:</strong>
    <%= post.reference_url %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= post.status %>
  </div>

  <div>
    <strong>Reminder sent at:</strong>
    <%= post.reminder_sent_at %>
  </div>

  <div>
    <strong>Published at:</strong>
    <%= post.published_at %>
  </div>

</div>
